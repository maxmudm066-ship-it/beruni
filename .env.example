# Beruniy CMS — environment template. Copy to `.env` and fill in real values.
# Never commit the filled-in `.env`: it holds the signing key and the database address.

# SQLite for development; PostgreSQL for hosting, e.g. postgresql://user:pass@host:5432/beruni
DATABASE_URL="file:./prisma/dev.db"

# Signs admin session tokens. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Directory for uploaded files. Relative paths resolve against the project root.
UPLOAD_DIR="uploads"

# Public address of the site: canonical URLs, og:url, sitemap.xml, robots.txt.
NEXT_PUBLIC_SITE_URL="https://example.org"

# Also set in the panel: Settings → SEO → site address (seo.site_url). It overrides the variable
# above for the same URLs, so both must say the same thing.

# Optional. When set, an external scheduler may call GET /api/cron/publish with
# `Authorization: Bearer <value>` to publish scheduled materials. Without it only a signed-in
# super administrator can trigger that endpoint, through POST.
CRON_SECRET=
